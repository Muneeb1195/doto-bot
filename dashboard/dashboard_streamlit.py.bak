import json
import csv
import re
from pathlib import Path
from collections import defaultdict

import streamlit as st
import pandas as pd
import plotly.express as px
import plotly.graph_objects as go

def rs(amount):
    return f"Rs.{amount:,.2f}"

BASE_DIR = Path(__file__).resolve().parent.parent
STATE_FILE = BASE_DIR / "data" / "dashboard_state.json"
TRADES_CSV = BASE_DIR / "logs" / "trades.csv"

st.set_page_config(page_title="Doto MT5 Bot Dashboard", layout="wide")
st.title("Doto MT5 Bot Dashboard")

@st.cache_data(ttl=10)
def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return None

@st.cache_data(ttl=10)
def load_trades():
    try:
        df = pd.read_csv(TRADES_CSV)
        if not df.empty and "exit_time" in df.columns:
            df["exit_time"] = pd.to_datetime(df["exit_time"], errors="coerce")
            df["entry_time"] = pd.to_datetime(df["entry_time"], errors="coerce")
        if "pnl" in df.columns:
            df["pnl"] = pd.to_numeric(df["pnl"], errors="coerce")
        return df
    except (FileNotFoundError, pd.errors.EmptyDataError):
        return pd.DataFrame()

state = load_state()
trades = load_trades()

# --- Top Metrics ---
col1, col2, col3, col4, col5 = st.columns(5)
if state:
    col1.metric("Balance", rs(state['balance']))
    col2.metric("Equity", rs(state['equity']))
    col3.metric("Floating P&L", rs(state['profit']))
    col4.metric("Margin Free", rs(state['margin_free']))
    col5.metric("Positions", str(state["positions"]))
else:
    for c in [col1, col2, col3, col4, col5]:
        c.metric("--", "--")

# --- MT5 Health ---
if state and state.get("health"):
    hcol1, hcol2 = st.columns(2)
    hcol1.metric("MT5 Connected", "Yes" if state["health"].get("connected") else "No")
    hcol2.metric("Server", state["health"].get("server", "--"))

# --- Open Positions ---
if state and state.get("positions_detail"):
    st.subheader("Open Positions")
    pos_df = pd.DataFrame(state["positions_detail"])
    pos_df["profit"] = pos_df["profit"].apply(lambda x: rs(x))
    st.dataframe(pos_df, width='stretch')

# --- Filter Rejection Breakdown ---
if state and state.get("filters"):
    st.subheader("Filter Rejection Breakdown")
    filter_data = []
    for sym, stats in state["filters"].items():
        row = {"Symbol": sym, "Signals": stats.get("signals", 0)}
        for k in ["exec", "volume", "volatility", "htf", "spread", "tape", "fine_entry", "ml", "tail_risk", "no_signal"]:
            row[k.capitalize()] = stats.get(k, 0)
        filter_data.append(row)
    if filter_data:
        fdf = pd.DataFrame(filter_data)
        total_cols = [c for c in fdf.columns if c not in ["Symbol"]]
        fdf["Total Rejected"] = fdf[[c for c in total_cols if c != "Signals"]].sum(axis=1)
        st.dataframe(fdf, width='stretch', hide_index=True)
        melted = fdf.melt(id_vars=["Symbol"], value_vars=[c for c in total_cols if c != "Signals"],
                          var_name="Filter", value_name="Count")
        if not melted.empty:
            fig = px.bar(melted, x="Symbol", y="Count", color="Filter", title="Filter Rejections by Symbol",
                         barmode="group")
            st.plotly_chart(fig, width='stretch')

# --- Equity Curve ---
st.subheader("Equity Curve")
eq_hist = state.get("equity_history") if state else None
closed_trades = trades[trades["event"].isin(["CLOSE", "REVERSAL", "MR_EXIT"])].copy() if not trades.empty else pd.DataFrame()

if eq_hist and len(eq_hist) > 1:
    eq_df = pd.DataFrame(eq_hist)
    eq_df["time"] = pd.to_datetime(eq_df["time"], errors="coerce")

    fig = go.Figure()
    fig.add_trace(go.Scatter(x=eq_df["time"], y=eq_df["balance"], mode="lines", name="Balance",
                             line=dict(color="green")))
    fig.add_trace(go.Scatter(x=eq_df["time"], y=eq_df["equity"], mode="lines", name="Equity",
                             line=dict(color="blue")))
    fig.update_layout(title="Balance & Equity (10s Snapshots)", xaxis_title="", yaxis_title="PKR",
                      hovermode="x unified")
    st.plotly_chart(fig, width='stretch')

    eq_df["peak"] = eq_df["equity"].cummax()
    eq_df["drawdown"] = (eq_df["peak"] - eq_df["equity"]) / eq_df["peak"] * 100
    fig_dd = go.Figure()
    fig_dd.add_trace(go.Scatter(x=eq_df["time"], y=eq_df["drawdown"], fill="tozeroy",
                                fillcolor="rgba(255,0,0,0.2)", line=dict(color="red"), name="Drawdown %"))
    fig_dd.update_layout(title="Drawdown %", yaxis_title="Drawdown (%)", hovermode="x unified")
    st.plotly_chart(fig_dd, width='stretch')
elif not closed_trades.empty:
    closed_trades = closed_trades.sort_values("exit_time")
    closed_trades["cum_pnl"] = closed_trades["pnl"].cumsum()
    base = state["balance"] - state["profit"] if state else 429000
    closed_trades["equity"] = base + closed_trades["cum_pnl"]

    fig = px.line(closed_trades, x="exit_time", y="equity", title="Equity Curve (Closed Trades)")
    fig.add_hline(y=closed_trades["equity"].iloc[0] if not closed_trades.empty else 0,
                  line_dash="dash", line_color="gray", annotation_text="Start")
    fig.update_layout(xaxis_title="", yaxis_title="Equity (PKR)")
    st.plotly_chart(fig, width='stretch')

    closed_trades["peak"] = closed_trades["equity"].cummax()
    closed_trades["drawdown"] = (closed_trades["peak"] - closed_trades["equity"]) / closed_trades["peak"] * 100
    fig_dd = px.area(closed_trades, x="exit_time", y="drawdown", title="Drawdown %")
    fig_dd.update_traces(fillcolor="rgba(255,0,0,0.2)", line_color="red")
    fig_dd.update_layout(yaxis_title="Drawdown (%)")
    st.plotly_chart(fig_dd, width='stretch')
else:
    st.info("No equity data yet — waiting for first dashboard snapshot")

# --- Daily P&L ---
st.subheader("Daily P&L")
if not trades.empty and "pnl" in trades.columns and "exit_time" in trades.columns:
    closed = trades[trades["event"].isin(["CLOSE", "REVERSAL", "MR_EXIT"])].copy()
    if not closed.empty and closed["exit_time"].notna().any():
        closed = closed.dropna(subset=["exit_time"])
        closed["exit_date"] = closed["exit_time"].dt.date
        daily = closed.groupby("exit_date")["pnl"].sum().reset_index()
        colors = ["green" if v >= 0 else "red" for v in daily["pnl"]]
        fig = px.bar(daily, x="exit_date", y="pnl", title="Daily P&L",
                     color=daily["pnl"] >= 0,
                     color_discrete_map={True: "green", False: "red"})
        fig.update_layout(showlegend=False, yaxis_title="P&L (PKR)")
        st.plotly_chart(fig, width='stretch')

# --- Performance Metrics ---
st.subheader("Performance Metrics")
if not trades.empty and "pnl" in trades.columns:
    closed = trades[trades["event"].isin(["CLOSE", "REVERSAL", "MR_EXIT"])]
    if not closed.empty:
        wins = closed[closed["pnl"] > 0]
        losses = closed[closed["pnl"] <= 0]
        total_pnl = closed["pnl"].sum()
        win_rate = len(wins) / len(closed) * 100 if len(closed) > 0 else 0
        avg_win = wins["pnl"].mean() if len(wins) > 0 else 0
        avg_loss = abs(losses["pnl"].mean()) if len(losses) > 0 else 0
        profit_factor = abs(wins["pnl"].sum() / losses["pnl"].sum()) if len(losses) > 0 and losses["pnl"].sum() != 0 else float("inf")

        mcol1, mcol2, mcol3, mcol4, mcol5 = st.columns(5)
        mcol1.metric("Total Trades", str(len(closed)))
        mcol2.metric("Win Rate", f"{win_rate:.1f}%")
        mcol3.metric("Total P&L", rs(total_pnl))
        mcol4.metric("Profit Factor", f"{profit_factor:.2f}" if profit_factor != float("inf") else "inf")
        mcol5.metric("Avg Win / Loss", f"{rs(avg_win)} / {rs(avg_loss)}")

        if "symbol" in closed.columns:
            st.subheader("P&L by Symbol")
            sym_pnl = closed.groupby("symbol")["pnl"].sum().reset_index()
            fig_bar = px.bar(sym_pnl, x="symbol", y="pnl", title="P&L by Symbol",
                             color="pnl", color_continuous_scale=["red", "green"])
            st.plotly_chart(fig_bar, width='stretch')

        # Regime performance
        if "event" in closed.columns:
            st.subheader("Regime Performance")
            closed["regime"] = closed["event"].apply(
                lambda x: "Ranging" if x == "MR_EXIT" else "Trending"
            )
            reg_perf = closed.groupby("regime").agg(
                Trades=("pnl", "count"),
                PnL=("pnl", "sum"),
                Win_Rate=("pnl", lambda x: (x > 0).mean() * 100),
            ).reset_index()
            reg_perf["Win_Rate"] = reg_perf["Win_Rate"].apply(lambda x: f"{x:.1f}%")
            reg_perf["PnL"] = reg_perf["PnL"].apply(lambda x: f"Rs.{x:+,.2f}")
            st.dataframe(reg_perf, width='stretch', hide_index=True)

# --- Trade Log ---
st.subheader("Trade Log")
if not trades.empty:
    cols = ["ticket", "symbol", "type", "volume", "entry_price", "exit_price", "pnl", "pips", "event", "entry_time", "exit_time"]
    display = trades[[c for c in cols if c in trades.columns]]
    sort_col = "exit_time" if "exit_time" in display.columns else ("entry_time" if "entry_time" in display.columns else None)
    if sort_col:
        display = display.sort_values(sort_col, ascending=False)
    st.dataframe(display, width='stretch', hide_index=True)
else:
    st.info("No trades logged yet")

# --- Regime Status ---
st.subheader("Regime Status")
if state and state.get("regimes"):
    reg_df = pd.DataFrame([{"Symbol": s, "Regime": r} for s, r in state["regimes"].items()])
    st.dataframe(reg_df, width='stretch', hide_index=True)

# --- Correlation Heatmap ---
st.subheader("Cross-Asset Correlation")
if state and state.get("correlation"):
    corr_dict = state["correlation"]
    symbols_set = set()
    for k in corr_dict:
        s1, s2 = k.split("-")
        symbols_set.add(s1)
        symbols_set.add(s2)
    symbols = sorted(symbols_set)
    n = len(symbols)
    corr_matrix = [[1.0] * n for _ in range(n)]
    for k, v in corr_dict.items():
        s1, s2 = k.split("-")
        i, j = symbols.index(s1), symbols.index(s2)
        corr_matrix[i][j] = v
        corr_matrix[j][i] = v
    fig = go.Figure(data=go.Heatmap(
        z=corr_matrix, x=symbols, y=symbols,
        colorscale="RdBu_r", zmin=-1, zmax=1,
        text=[[f"{v:.2f}" for v in row] for row in corr_matrix],
        texttemplate="%{text}",
        textfont={"size": 10},
    ))
    fig.update_layout(height=400)
    st.plotly_chart(fig, width='stretch')

# --- Bot Log ---
with st.expander("Bot Log", expanded=False):
    try:
        log_dir = BASE_DIR / "logs"
        log_files = sorted(log_dir.glob("bot_*.log"))
        if not log_files:
            st.info("No bot log files found")
        else:
            log_path = log_files[-1]
            log_pat = re.compile(r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3} \[(INFO|WARNING|ERROR)\]")
            with open(log_path, encoding="utf-8", errors="replace") as f:
                lines = [l for l in f.read().splitlines() if log_pat.match(l)][-60:]
            log_text = "\n".join(lines)
            st.text(log_text)
    except Exception as e:
        st.info(f"Log not available: {e}")

import time
st.caption("Auto-refreshes every 10 seconds")
time.sleep(10)
st.rerun()
